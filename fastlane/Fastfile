require "shellwords"

default_platform(:mac)

platform :mac do
  before_all do
    load_local_env

    ensure_env_vars(
      env_vars: %w[
        OVERHYPER_TEAM_ID
        OVERHYPER_CODE_SIGN_IDENTITY
        OVERHYPER_APP_IDENTIFIER
      ]
    )

    verify_env_values
    verify_xcode_cli
    verify_metal_toolchain
    verify_signing_identity
  end

  private_lane :load_local_env do
    env_file = File.join(__dir__, ".env.local")
    return unless File.exist?(env_file)

    require "dotenv"
    Dotenv.overload(env_file)
  end

  private_lane :verify_env_values do
    if ENV.fetch("OVERHYPER_TEAM_ID") == "YOUR_TEAM_ID"
      UI.user_error!(
        "OVERHYPER_TEAM_ID is still a template value. " \
        "Set it in fastlane/.env.local and run with --env local."
      )
    end

    identity_template = "Apple Development: Your Name (TEAMID)"
    if ENV.fetch("OVERHYPER_CODE_SIGN_IDENTITY") == identity_template
      UI.user_error!(
        "OVERHYPER_CODE_SIGN_IDENTITY is still a template value. " \
        "Set it in fastlane/.env.local and run with --env local."
      )
    end
  end

  private_lane :verify_xcode_cli do
    sh("xcodebuild -version")
  rescue StandardError => error
    UI.user_error!(
      "Xcode command line tools are not available: #{error.message}"
    )
  end

  private_lane :verify_metal_toolchain do
    component_info = sh(
      "xcodebuild -showComponent MetalToolchain",
      log: false
    )

    unless component_info.include?("Status: installed")
      UI.user_error!(
        "Metal Toolchain is not installed. " \
        "Install it with: xcodebuild -downloadComponent MetalToolchain"
      )
    end

    toolchain_identifier = component_info[/Toolchain Identifier:\s*(\S+)/, 1]
    unless toolchain_identifier
      UI.user_error!(
        "Metal Toolchain is installed, but its toolchain identifier was not found."
      )
    end

    Actions.lane_context[:OVERHYPER_METAL_TOOLCHAIN_IDENTIFIER] = toolchain_identifier
  rescue StandardError => error
    UI.user_error!(
      "Metal Toolchain is not available: #{error.message}. " \
      "Install it with: xcodebuild -downloadComponent MetalToolchain"
    )
  end

  private_lane :verify_signing_identity do
    identity_list = sh(
      "security find-identity -v -p codesigning",
      log: false
    )

    if identity_list.include?("0 valid identities found")
      UI.user_error!(
        "No valid code-signing identities found in keychain. " \
        "Create an Apple Development certificate in Xcode " \
        "(Settings > Accounts > Manage Certificates)."
      )
    end

    expected_identity = ENV.fetch("OVERHYPER_CODE_SIGN_IDENTITY")
    unless identity_list.include?(expected_identity)
      UI.user_error!(
        "Signing identity not found: #{expected_identity}. " \
        "Check your keychain or update OVERHYPER_CODE_SIGN_IDENTITY."
      )
    end
  end

  private_lane :clean_dist_app do |options|
    dist_path = File.expand_path("../dist", __dir__)
    app_path = File.join(dist_path, options.fetch(:app_name))

    sh("mkdir -p #{Shellwords.escape(dist_path)}")
    sh("rm -rf #{Shellwords.escape(app_path)}")
  end

  private_lane :build_app_to_dist do |options|
    configuration = options.fetch(:configuration)
    app_name = options.fetch(:app_name)
    build_path = options.fetch(:build_path)
    derived_data_path = options.fetch(:derived_data_path)
    packages_path = options.fetch(:packages_path)
    app_product_path = "#{derived_data_path}/Build/Products/#{configuration}/OverHyper.app"
    app_output_path = File.expand_path("../dist/#{app_name}", __dir__)
    escaped_identity = Shellwords.escape(ENV.fetch("OVERHYPER_CODE_SIGN_IDENTITY"))
    metal_toolchain_identifier = Actions.lane_context.fetch(
      :OVERHYPER_METAL_TOOLCHAIN_IDENTIFIER
    )
    escaped_metal_toolchain = Shellwords.escape(metal_toolchain_identifier)

    clean_dist_app(app_name: app_name)

    build_mac_app(
      project: "OverHyper.xcodeproj",
      scheme: "OverHyper",
      configuration: configuration,
      clean: true,
      skip_archive: true,
      skip_package_pkg: true,
      build_path: build_path,
      derived_data_path: derived_data_path,
      cloned_source_packages_path: packages_path,
      xcargs: [
        "-toolchain #{escaped_metal_toolchain}",
        "DEVELOPMENT_TEAM=#{ENV.fetch('OVERHYPER_TEAM_ID')}",
        "CODE_SIGN_IDENTITY=#{escaped_identity}",
        "PRODUCT_BUNDLE_IDENTIFIER=#{ENV.fetch('OVERHYPER_APP_IDENTIFIER')}",
        "CODE_SIGN_STYLE=Manual",
      ].join(" ")
    )

    unless File.directory?(app_product_path)
      UI.user_error!("Built app not found: #{app_product_path}")
    end

    sh("ditto #{Shellwords.escape(app_product_path)} #{Shellwords.escape(app_output_path)}")
  end

  lane :self_use_build do
    build_app_to_dist(
      configuration: "Release",
      app_name: "OverHyper.app",
      build_path: "/tmp/OverHyperBuild",
      derived_data_path: "/tmp/OverHyperDerivedRelease",
      packages_path: "/tmp/OverHyperPackages"
    )
  end

  lane :debug_build do
    build_app_to_dist(
      configuration: "Debug",
      app_name: "OverHyper-Debug.app",
      build_path: "/tmp/OverHyperBuildDebug",
      derived_data_path: "/tmp/OverHyperDerivedDebug",
      packages_path: "/tmp/OverHyperPackages"
    )
  end

  after_all do |lane|
    case lane
    when :self_use_build
      UI.success("fastlane self_use_build completed")
      UI.message("Built app: dist/OverHyper.app")
      UI.message("Launch with: open dist/OverHyper.app")
    when :debug_build
      UI.success("fastlane debug_build completed")
      UI.message("Built debug app: dist/OverHyper-Debug.app")
      UI.message("Launch with: open dist/OverHyper-Debug.app")
    end
  end

  error do |lane, exception|
    UI.error("fastlane lane failed: #{lane}")
    UI.error(exception.message)
    UI.important("Retry with: bundle exec fastlane #{lane}")
  end
end
